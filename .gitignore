.DS_Store
**/.DS_Store

# iCloud conflict duplicates
*\ *
*\ 2.*
*\ 3.*
*\ 2
*\ 3

# Claude Code worktrees
.claude/worktrees/
.env
.env.local
.env.*.local
.venv
__pycache__
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.uv-cache/
.serena
.worktrees
.omx/
node_modules/
dist/
build/
coverage/
*.log

# External datasets (large, downloaded separately)
data/external/mcp-zero/
data/external/mcp-atlas/

# Experiment results (tracked for reproducibility)
# data/results/

# W&B run logs
wandb/

# AWS SAM build artifacts
.aws-sam/
service/.aws-sam/

# Deterministic build artifacts
service/dist/

# SAM local env overrides (contain secrets)
service/env.local.json
service/env.*.json

# Supabase CLI temp files (generated by supabase link/init)
/supabase/
service/supabase/.temp/

.omc/
.playwright-mcp/

# Probe cache (ephemeral, 24h TTL content-hash cache)
data/probes/.cache/

# Probe snapshots (large, gitignored except .gitkeep)
data/probes/snapshots/*
!data/probes/snapshots/.gitkeep
