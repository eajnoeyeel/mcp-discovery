{"tool_id": "puppeteer::puppeteer_navigate", "enriched_text": "puppeteer_navigate Navigate to any URL in the browser Parameters: url, launchOptions, allowDangerous", "method": "rule"}
{"tool_id": "puppeteer::puppeteer_screenshot", "enriched_text": "puppeteer_screenshot Capture screenshots of the entire page or specific elements Parameters: name, selector, width, height, encoded", "method": "rule"}
