{"tool_id": "EthanHenrickson/math-mcp::arcsin", "enriched_text": "arcsin Calculates the arcsine of a number in radians Parameters: number", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::cos", "enriched_text": "cos Calculates the cosine of a number in radians Parameters: number", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::arccos", "enriched_text": "arccos Calculates the arccosine of a number in radians Parameters: number", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::tan", "enriched_text": "tan Calculates the tangent of a number in radians Parameters: number", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::arctan", "enriched_text": "arctan Calculates the arctangent of a number in radians Parameters: number", "method": "rule"}
