{"tool_id": "sentry::sentry-issue", "enriched_text": "sentry-issue Retrieve issue details from Sentry Parameters: issue_id_or_url", "method": "rule"}
{"tool_id": "sequential_thinking::sequential_thinking", "enriched_text": "sequential_thinking Facilitates a detailed, step-by-step thinking process for problem-solving and analysis. Parameters: thought, nextThoughtNeeded, thoughtNumber, totalThoughts, isRevision, revisesThought, branchFromThought, branchId, needsMoreThoughts", "method": "rule"}
{"tool_id": "sqlite::read_query", "enriched_text": "read_query Execute SELECT queries to read data from the database Parameters: query", "method": "rule"}
{"tool_id": "sqlite::write_query", "enriched_text": "write_query Execute INSERT, UPDATE, or DELETE queries Parameters: query", "method": "rule"}
{"tool_id": "sqlite::create_table", "enriched_text": "create_table Create new tables in the database Parameters: query", "method": "rule"}
{"tool_id": "sqlite::list_tables", "enriched_text": "list_tables Get a list of all tables in the database", "method": "rule"}
{"tool_id": "sqlite::describe-table", "enriched_text": "describe-table View schema information for a specific table Parameters: table_name", "method": "rule"}
{"tool_id": "sqlite::append_insight", "enriched_text": "append_insight Add new business insights to the memo resource Parameters: insight", "method": "rule"}
{"tool_id": "time::get_current_time", "enriched_text": "get_current_time Get current time in a specific timezone or system timezone. Parameters: timezone", "method": "rule"}
{"tool_id": "time::convert_time", "enriched_text": "convert_time Convert time between timezones. Parameters: source_timezone, time, target_timezone", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_CREATE_CAROUSEL_CONTAINER", "enriched_text": "INSTAGRAM_CREATE_CAROUSEL_CONTAINER Create a draft carousel post with multiple images/videos before publishing. Parameters: caption, children, ig_user_id, child_image_urls, child_video_urls, child_image_files, child_video_files, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_CREATE_MEDIA_CONTAINER", "enriched_text": "INSTAGRAM_CREATE_MEDIA_CONTAINER Create a draft media container for photos/videos/reels before publishing. Parameters: caption, cover_url, image_url, video_url, ig_user_id, image_file, media_type, video_file, content_type, is_carousel_item, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_CREATE_POST", "enriched_text": "INSTAGRAM_CREATE_POST Publish a draft media container to Instagram (final publishing step). Parameters: ig_user_id, creation_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_CONVERSATION", "enriched_text": "INSTAGRAM_GET_CONVERSATION Get details about a specific Instagram DM conversation (participants, etc). Parameters: conversation_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_POST_COMMENTS", "enriched_text": "INSTAGRAM_GET_POST_COMMENTS Get comments on an Instagram post. Parameters: after, limit, ig_post_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_POST_INSIGHTS", "enriched_text": "INSTAGRAM_GET_POST_INSIGHTS Get Instagram post insights/analytics (impressions, reach, engagement, etc.). Parameters: metric, ig_post_id, metric_preset, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_POST_STATUS", "enriched_text": "INSTAGRAM_GET_POST_STATUS Check the processing status of a draft post container. Parameters: creation_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_USER_INFO", "enriched_text": "INSTAGRAM_GET_USER_INFO Get Instagram user info including profile details and statistics. Parameters: ig_user_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_USER_INSIGHTS", "enriched_text": "INSTAGRAM_GET_USER_INSIGHTS Get Instagram account-level insights and analytics (profile views, reach, follower count, etc.). metric_type (time_series or total_value): When set to total_value, the API returns a total_value object instead of values. breakdown: Only applicable when metric_type=total_value and only for supported metrics. timeframe: Required for demographics-related metrics and overrides since/until for those metrics. Parameters: since, until, metric, period, breakdown, timeframe, ig_user_id, metric_type, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_GET_USER_MEDIA", "enriched_text": "INSTAGRAM_GET_USER_MEDIA Get Instagram user's media (posts, photos, videos). Parameters: after, limit, ig_user_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_LIST_ALL_CONVERSATIONS", "enriched_text": "INSTAGRAM_LIST_ALL_CONVERSATIONS List all Instagram DM conversations for the authenticated user. Parameters: after, limit, ig_user_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_LIST_ALL_MESSAGES", "enriched_text": "INSTAGRAM_LIST_ALL_MESSAGES List all messages from a specific Instagram DM conversation. Parameters: after, limit, conversation_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_MARK_SEEN", "enriched_text": "INSTAGRAM_MARK_SEEN Mark Instagram DM messages as read/seen for a specific user. Parameters: recipient_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_REPLY_TO_COMMENT", "enriched_text": "INSTAGRAM_REPLY_TO_COMMENT Reply to a comment on Instagram media. Parameters: message, ig_comment_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_SEND_IMAGE", "enriched_text": "INSTAGRAM_SEND_IMAGE Send an image via Instagram DM to a specific user. Parameters: caption, image_url, recipient_id, graph_api_version", "method": "rule"}
{"tool_id": "instagram::INSTAGRAM_SEND_TEXT_MESSAGE", "enriched_text": "INSTAGRAM_SEND_TEXT_MESSAGE Send a text message to an Instagram user via DM. Parameters: text, ig_user_id, recipient_id, graph_api_version, reply_to_message_id", "method": "rule"}
