{"tool_id": "EthanHenrickson/math-mcp::max", "enriched_text": "max Finds the maximum value from a list of numbers Parameters: numbers", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::floor", "enriched_text": "floor Rounds a number down to the nearest integer Parameters: number", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::ceiling", "enriched_text": "ceiling Rounds a number up to the nearest integer Parameters: number", "method": "rule"}
{"tool_id": "EthanHenrickson/math-mcp::round", "enriched_text": "round Rounds a number to the nearest integer Parameters: number", "method": "rule"}
